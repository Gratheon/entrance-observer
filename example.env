# API token, hive ID, section ID, telemetry/video upload URLs and night mode are configured in the web UI Settings page.
# These legacy env vars are still supported as fallback when the setting is empty.
# API_TOKEN=...
# HIVE_ID=364
# SECTION_ID=1944
# VIDEO_UPLOAD_URL=https://video.gratheon.com/graphql
CAMERA_DEVICE=0
FPS=30
WIDTH_PX=640
HEIGHT_PX=480
CONFIDENCE=0.5
DETECTION_LINE=0.5
VIDEO_CHUNK_LENGTH_SEC=60
# TELEMETRY_BASE_URL=https://telemetry.gratheon.com
# TELEMETRY_UPLOAD_PATH=/entrance/v1/movement
# Optional override for full telemetry URL (takes precedence over BASE_URL + PATH):
# TELEMETRY_UPLOAD_URL=http://localhost:8080/entrance/v1/movement
# DAY_START_HOUR=6
# DAY_END_HOUR=22

# Storage fallbacks; prefer the web UI Storage Settings page.
# VIDEOS_DIR=./videos
# TELEMETRY_DIR=./telemetry
# TELEMETRY_RETENTION_DAYS=30
# RUNS_DIR=./runs
# RUNS_RETENTION_DAYS=7
# MIN_FREE_DISK_MB=1024
# MAX_MANAGED_STORAGE_MB=0
VIDEO_RETENTION_MINUTES=1440
DETECT_VIDEO_WIDTH=320
DETECT_VIDEO_HEIGHT=240
DETECT_VIDEO_RETENTION_MINUTES=10
